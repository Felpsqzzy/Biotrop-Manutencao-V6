NODE_ENV=production
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=https://manutencao.biotrop.com.br

# Preencha somente no /opt/biotrop/.env.app da VM (root:biotrop 0640).
# Não coloque usuário/senha reais neste arquivo versionado.
DATABASE_URL=
DATABASE_SSL=true
# Conteúdo PEM da CA fornecida pela TI, com quebras de linha escritas como \n.
DATABASE_SSL_CA=
DATABASE_TLS_MIN=TLSv1.2
DB_POOL_MAX=20

SESSION_SECRET=
SESSION_HOURS=10
SESSION_IDLE_MINUTES=60
TWOFA_KEY=
# Terminal do almoxarifado: custo do scrypt da senha do tablet (2^17; a produção recusa menos). Opcional.
# Subir o valor: enquanto houver senha no custo antigo, cada login calcula os dois (ver docs/DEPLOY-TI.md, seção 9).
TERMINAL_SCRYPT_LOG2N=17

ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=

# A VM usa identidade gerenciada: nenhuma chave do Key Vault fica em arquivo.
KMS_PROVEDOR=azure
AZURE_KEYVAULT_KEY_ID=https://NOME-DO-COFRE.vault.azure.net/keys/biomanut-dados
# Opcional apenas para identidade gerenciada atribuída pelo usuário.
AZURE_CLIENT_ID=
CRIPTO_INQUILINO=biotrop

COOKIE_SECURE=true
TRUST_PROXY=1
