[Unit]
Description=BIOTROP worker do SharePoint (bateladas -> lista Bateladas da Inteligencia de Dados)
Documentation=file:///opt/biotrop/deploy/systemd/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# Conta própria: o worker não lê o .env.app do site e o site não lê o .env.worker.
User=biotrop-worker
Group=biotrop-worker
WorkingDirectory=/opt/biotrop
# Mesmo arquivo do worker de e-mail: DATABASE_WORKER_URL, GRAPH_* e SHAREPOINT_* (ver docs/SHAREPOINT-BATELADAS.md).
# Nunca inclua DATABASE_ADMIN_URL, DATABASE_URL do site, SESSION_SECRET, TWOFA_KEY nem ENTRA_*.
EnvironmentFile=/opt/biotrop/.env.worker
# Variáveis do EnvironmentFile têm prioridade sobre Environment=; mantenha NODE_ENV=production lá.
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/biotrop/server/src/worker-sharepoint.js
Restart=always
RestartSec=10
UMask=0077

# ---- Endurecimento (mesmo perfil do site; confira com systemd-analyze security) ----
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
# O worker não grava em disco (loga no journal): nenhum ReadWritePaths.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
RemoveIPC=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# MemoryDenyWriteExecute NÃO é usado de propósito: o JIT do V8 precisa de páginas W+X.
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
