NODE_ENV=production
PORT=3000
APP_BASE_URL=https://manutencao.biotrop.com.br

# PostgreSQL da VM. Use um usuário exclusivo da aplicação.
# Valores sensíveis ficam vazios no modelo e só existem no .env local ignorado pelo Git.
DATABASE_URL=
DATABASE_ADMIN_URL=
APP_DB_PASSWORD=
DATABASE_WORKER_URL=
WORKER_DB_PASSWORD=
DATABASE_SSL=false
# Obrigatório quando DATABASE_SSL=true. Use o certificado CA entregue pela TI.
DATABASE_SSL_CA=
DB_POOL_MAX=20

# Gere com: openssl rand -base64 48
SESSION_SECRET=
SESSION_HOURS=10
SESSION_IDLE_MINUTES=60
# Chave própria para cifrar o 2FA (openssl rand -base64 48). Não troque depois de ativar o 2FA.
TWOFA_KEY=
# Terminal do almoxarifado: custo do hash (scrypt) da senha do tablet, N = 2^valor. Opcional; padrão 17, e a produção
# recusa menos que 17 ao iniciar. Cada login usa ~128 MiB de RAM por alguns instantes (no máximo 2 ao mesmo tempo:
# ~256 MiB; até 32 esperam na fila e o resto recebe 503, ver server/src/lib/senha-terminal.js).
# Subir o valor não invalida as senhas (o hash guarda o N usado); enquanto houver senha no custo antigo, cada login
# calcula os dois custos (mais lento). Convite de redefinição no painel encurta a transição.
TERMINAL_SCRYPT_LOG2N=17
# Threads do libuv (padrão 4). Com até 2 scrypts ocupando threads, 8 deixa folga para DNS, arquivos e o TLS do banco.
# Precisa estar no ambiente ANTES de o Node iniciar. A unit systemd (Environment=UV_THREADPOOL_SIZE=8) e o Dockerfile
# já definem; no .env.app só para sobrescrever esse valor (no systemd, o EnvironmentFile vence o Environment=).
UV_THREADPOOL_SIZE=8

# App Registration do login web criada pela TI no Microsoft Entra ID.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=

# Microsoft Graph: registro separado do login web, somente no servidor.
# Exige Mail.Send (Application) e Application Access Policy restrita à caixa abaixo.
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=
EMAIL_REMETENTE=manutencao@biotrop.com.br
# Motivo fora desta lista é cancelado pelo worker ("Motivo não habilitado para envio"), sem chamar o Graph.
# Empréstimo do almoxarifado (migration 42, emprestimo.enfileirar_avisos() a cada ciclo; liga/desliga e prazos no painel):
#   emprestimo_lembrete (antes do prazo), emprestimo_vencimento (no vencimento), emprestimo_atraso (recorrente),
#   emprestimo_escalonamento (atraso longo, ao almoxarifado com os gestores em cópia), emprestimo_devolucao (devolução conferida).
EMAIL_MOTIVOS_ATIVOS=sci_revisao_solicitante,lms_cobranca_gestor,lms_certificado,copiloto_cobranca,emprestimo_lembrete,emprestimo_vencimento,emprestimo_atraso,emprestimo_escalonamento,emprestimo_devolucao
EMAIL_INTERVALO_MS=60000
EMAIL_LOTE=20
EMAIL_TENTATIVAS_MAX=5
EMAIL_TIMEOUT_MS=15000
# 1 valida e lista a fila sem chamar o Graph nem alterar registros.
EMAIL_DRY_RUN=1

# Bateladas -> lista "Bateladas" do SharePoint (worker-sharepoint.js; usa o mesmo GRAPH_*).
# Exige Sites.Selected (aplicativo) e a concessão "write" no site, feita pela TI: docs/SHAREPOINT-BATELADAS.md.
SHAREPOINT_SITE=bioaqua.sharepoint.com:/sites/InteligenciaDados
SHAREPOINT_LISTA_BATELADAS=d07b105d-58cf-4bbd-b406-e6628fc635ab
SHAREPOINT_INTERVALO_MS=300000
# 1 lê a fila e mostra o que enviaria, sem chamar o Graph.
SHAREPOINT_DRY_RUN=1

# Cookies seguros exigem HTTPS em produção.
COOKIE_SECURE=true
TRUST_PROXY=1

# Somente para Docker Compose (não reutilize a senha da aplicação).
POSTGRES_PASSWORD=

# Copiloto BIOMANUT (assistente dentro do site). Chave da API do Claude (https://console.anthropic.com), SÓ no servidor.
# Sem ela o copiloto fica desligado. As perguntas e os dados que aparecem na conversa vão ao serviço da Anthropic.
ANTHROPIC_API_KEY=
COPILOTO_MODELO=claude-sonnet-5-5
COPILOTO_LIMITE_DIA=200
